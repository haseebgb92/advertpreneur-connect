# Optional override. On Vercel the app automatically detects its production URL.
ADPC_BASE_URL=

# Private Supabase Edge Function storage API.
ADPC_STORE_URL=
ADPC_STORE_TOKEN=

# Long random secrets. Never commit production values.
ADPC_ENCRYPTION_KEY=
ADPC_STATE_SECRET=

# Bearer token used by Custom GPT Actions.
ADPC_ACTION_TOKEN=

# Optional MCP bearer. If unset, the MCP endpoint stays disabled.
ADPC_MCP_BEARER_TOKEN=

# Stable UUID used by WordPress Application Password authorization.
ADPC_APP_ID=53ef64c2-71b5-4cf2-baa7-e416f9cf7afd
