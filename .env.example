# Public stable deployment URL, e.g. https://advertpreneur-connect.vercel.app
PUBLIC_BASE_URL=

# Persistent Postgres. Works with Supabase/Neon/Vercel Postgres-compatible providers.
DATABASE_URL=

# Long random secrets. Never commit production values.
ENCRYPTION_KEY=
STATE_SECRET=

# Optional shared bearer for private testing. Prefer OAuth before wider distribution.
MCP_BEARER_TOKEN=

# Stable UUID used by WordPress Application Password authorization.
APP_ID=53ef64c2-71b5-4cf2-baa7-e416f9cf7afd
